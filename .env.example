# Genera estas credenciales en https://console.cloud.google.com/apis/credentials
# Tipo de credencial: OAuth Client ID > Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Genera un valor random, por ejemplo con: npx auth secret
AUTH_SECRET=

# Emails que deben quedar como administradores automáticamente al iniciar
# sesión por primera vez (separados por coma). El resto de usuarios nuevos
# entra con rol de solo lectura.
ADMIN_EMAILS=
